# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/talentscout

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Your OpenAI (or compatible) API key
OPENAI_API_KEY=sk-your-api-key-here

# Base URL — change to use Azure, Groq, Ollama, etc.
# OpenAI default: https://api.openai.com/v1
# Ollama example: http://localhost:11434/v1
OPENAI_API_BASE=https://api.openai.com/v1

# LLM model name (must exist on your provider)
MODEL_NAME=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=TalentScout
APP_VERSION=1.0.0
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for development)
ALLOWED_ORIGINS=["*"]

# ── Security ─────────────────────────────────────────────────────────────────
# Change this to a strong random string in production
SECRET_KEY=change-me-in-production

# ── LLM params ────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# ── Bonus hooks ───────────────────────────────────────────────────────────────
ENABLE_SENTIMENT_ANALYSIS=false
DEFAULT_LANGUAGE=en
ENABLE_AUTH=false

# ── Frontend ─────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000/api/v1
